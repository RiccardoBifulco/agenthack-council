{
  "name": "agenthack-council",
  "version": "0.2.1",
  "description": "Adversarial AI Security Harness & Model Council (Advocate -> Skeptic -> Judge) for AI Agents, MCP Servers, SKILL.md & Agentic Repos.",
  "type": "module",
  "bin": {
    "agenthack-council": "./dist/src/cli.js",
    "agenthack": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/src/cli.js",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "demo": "npm run build && node dist/src/cli.js demo",
    "demo:ui": "npm run build && node dist/src/cli.js demo --ui",
    "self-audit": "npm run build && node dist/src/cli.js . --council heuristic --prove --fail-on-confirmed"
  },
  "keywords": [
    "ai-security",
    "agent-security",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "codex",
    "prompt-injection",
    "tool-poisoning",
    "security-scanner",
    "llm-security",
    "model-council",
    "sarif",
    "devsecops"
  ],
  "author": "Riccardo Bifulco <https://github.com/RiccardoBifulco>",
  "license": "MIT",
  "homepage": "https://github.com/RiccardoBifulco/agenthack-council#readme",
  "bugs": {
    "url": "https://github.com/RiccardoBifulco/agenthack-council/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RiccardoBifulco/agenthack-council.git"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
