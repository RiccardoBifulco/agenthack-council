    "security-scanner",
    "llm-security",
    "model-council",
    "agent-security"
  ],
  "author": "Riccardo Bifulco <https://github.com/RiccardoBifulco>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RiccardoBifulco/agenthack-council.git"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
